# ============================================================================
# FaultLab configuration. Copy to .env and adjust. Every value has a default.
# Unset variables fall back to defaults; do NOT leave a variable present but empty.
# ============================================================================

# ---------- Database --------------------------------------------------------
# Local PostgreSQL container (profile local-db). Docker DNS name "postgres".
USE_LOCAL_DB=true
DB_URL=jdbc:postgresql://postgres:5432/faultlab
DB_USERNAME=faultlab
DB_PASSWORD=faultlab

# Neon: set USE_LOCAL_DB=false and uncomment. Pooled (PgBouncer) for app traffic, direct for Flyway.
# DB_POOLED_URL=jdbc:postgresql://<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channelBinding=require
# DB_DIRECT_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channelBinding=require
# DB_USERNAME=<neon user>
# DB_PASSWORD=<neon password>

POSTGRES_MAX_CONNECTIONS=100

# HikariCP, per service
ORDER_DB_POOL_MAX_SIZE=10
ORDER_DB_POOL_MIN_IDLE=2
ORDER_DB_CONNECTION_TIMEOUT_MS=3000
ORDER_DB_ARTIFICIAL_DELAY=0ms
INVENTORY_DB_POOL_MAX_SIZE=10
INVENTORY_DB_POOL_MIN_IDLE=2
INVENTORY_DB_CONNECTION_TIMEOUT_MS=3000
INVENTORY_DB_ARTIFICIAL_DELAY=0ms

# ---------- Service-to-service HTTP ----------------------------------------
INVENTORY_BASE_URL=http://inventory-service:8081
HTTP_CONNECT_TIMEOUT=500ms
HTTP_RESPONSE_TIMEOUT=2s

# ---------- Retry -----------------------------------------------------------
RETRY_ENABLED=true
# NONE | MANUAL | RESILIENCE4J
RETRY_MODE=RESILIENCE4J
RETRY_MAX_ATTEMPTS=3
RETRY_STATUS_CODES=502,503,504
RETRY_EXCEPTIONS=java.net.ConnectException,java.net.http.HttpTimeoutException,java.net.SocketTimeoutException
# FIXED | LINEAR | EXPONENTIAL
RETRY_BACKOFF_STRATEGY=EXPONENTIAL
RETRY_INITIAL_INTERVAL=100ms
RETRY_MULTIPLIER=2.0
RETRY_MAX_INTERVAL=2s
# NONE | FULL | EQUAL
RETRY_JITTER=FULL

# ---------- Circuit breaker / bulkhead -------------------------------------
CB_ENABLED=true
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_RATE_THRESHOLD=80
CB_SLOW_CALL_DURATION=1500ms
CB_SLIDING_WINDOW_TYPE=COUNT_BASED
CB_SLIDING_WINDOW_SIZE=20
CB_MINIMUM_CALLS=10
CB_WAIT_OPEN=10s
CB_HALF_OPEN_CALLS=5
BULKHEAD_ENABLED=true
BULKHEAD_MAX_CONCURRENT=50
BULKHEAD_MAX_WAIT=0ms

# ---------- Reconciler (resolves RESERVATION_UNKNOWN orders) ---------------
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=30000

# ---------- Inventory failure simulation (startup defaults) ----------------
FAILURE_MODE=NORMAL
FAILURE_SLOW_LATENCY_MS=5000
FAILURE_RATE=0.3

# ---------- Telemetry -------------------------------------------------------
OTEL_JAVAAGENT_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEPLOY_ENV=local

# ---------- Logging (Logstash requires: start-observability.ps1 -Logging) ---
LOGSTASH_ENABLED=false
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000
FAULTLAB_LOG_LEVEL=INFO

# ---------- Ports / resources ----------------------------------------------
ORDER_HOST_PORT=8080
INVENTORY_HOST_PORT=8081
POSTGRES_HOST_PORT=5432
ORDER_CPUS=1.0
ORDER_MEMORY=768M
INVENTORY_CPUS=1.0
INVENTORY_MEMORY=768M

# ---------- Grafana ---------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
