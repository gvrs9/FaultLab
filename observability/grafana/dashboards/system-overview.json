        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"order-service\",uri!~\"/actuator.*\",status!~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"order-service\",uri!~\"/actuator.*\"}[1m])), 1e-9)",
          "legendFormat": "success",
          "exemplar": true
        }
      ]
    },
